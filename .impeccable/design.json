  "narrative": {
    "northStar": "The Attacker's Dossier",
    "overview": "Every surface is a page from the file an outsider would keep on you, kept as a dark intelligence dossier on a strict 60/30/10: Abyss Navy surfaces, Camel Suede structure (tabs, bands, rules, labels, redaction tape, infrastructure lines), Electric Kiwi only for action, focus, and the single thing to fix first. Typed exhibits are Courier Prime, prose is Public Sans, titles are condensed Archivo. Structure comes from rules, not fills; evidence is annotated where it sits.",
    "keyCharacteristics": [
      "A strict 60 / 30 / 10: Abyss Navy surfaces, Camel Suede structure, Electric Kiwi action.",
      "Square corners everywhere; the die-cut tab and the drawn stamp are the only other silhouettes.",
      "Rules and line style carry structure and category; fills are reserved for bands, tabs, and the folder.",
      "Kiwi appears on the primary action, focus, the active tab, and once per surface on the P0.",
      "Condensed Archivo for titles and stamps, Public Sans for prose, Courier Prime for anything collected."
    ],
    "rules": [
      {
        "name": "The 60/30/10 Rule",
        "body": "Navy owns the surface, camel owns the structure, kiwi owns the action. If a new element is neither, it is text.",
        "section": "colors"
      },
      {
        "name": "The One Kiwi Mark Rule",
        "body": "A surface carries one kiwi stamp, on the one item to fix first; the same item may repeat kiwi in its P0 chip.",
        "section": "colors"
      },
      {
        "name": "The Edge-Not-Hue Rule",
        "body": "Severity color rides edges, swatches, bars, and lines; labels are neutral text and always present.",
        "section": "colors"
      },
      {
        "name": "The Untinted Panel Rule",
        "body": "Panels, cards, and memos are raised navy or transparent with camel rules; row hover washes are state, not structure.",
        "section": "colors"
      },
      {
        "name": "The Line-Not-Hue Rule",
        "body": "Non-severity categories are told by line style: filled prod, outlined staging, dashed dev, dotted unknown.",
        "section": "colors"
      },
      {
        "name": "The Typed-Evidence Rule",
        "body": "Collected data is Courier Prime; written prose is Public Sans.",
        "section": "typography"
      },
      {
        "name": "The Neutral Prose Rule",
        "body": "Paragraphs are off-white or secondary text; camel and kiwi never color running text.",
        "section": "typography"
      },
      {
        "name": "The Sheet-On-Folder Rule",
        "body": "A shadow means a sheet is lying in the file. Nothing on a sheet casts a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the balance: navy surfaces, camel structure, kiwi only where the user acts or must act first.",
      "Do put every content surface on a raised navy sheet over the grained navy field.",
      "Do build structure from camel rules: 2px for heads, 1px hairlines at 15 to 30% for dividers.",
      "Do set collected data in Courier Prime and prose in Public Sans, in off-white or secondary text.",
      "Do carry severity on borders, swatches, bars, and edges, with a text label every time.",
      "Do draw the live path in kiwi and fade the rest to camel until hovered.",
      "Do frame every surface with a classification band stating the passive, authorized scope.",
      "Do give every motion a reduced-motion state that shows the finished result."
    ],
    "donts": [
      "Don't use kiwi for large backgrounds, every icon or border, or a second stamp.",
      "Don't set paragraphs in camel or kiwi.",
      "Don't introduce purple, pink, cyan, or blue accents, SaaS gradients, glow, or glassmorphism.",
      "Don't hardcode a color in a component; add or reuse a token in globals.css.",
      "Don't round corners or cast shadows inside a sheet.",
      "Don't set titles in Public Sans or uncondensed Archivo."
    ]
  }
}
# Copy to .env (repo root) and fill in. Never commit .env.
# The backend reads backend/.env, then this file; real environment variables always win.

# --- Frontend (VITE_* values are bundled into the browser: never put secrets here) ---
VITE_API_URL=http://localhost:8000
# true = labelled acme-demo fixtures, no backend, no sign-in. false = real API.
VITE_USE_MOCKS=false

# --- Backend ---
APP_ENV=development            # development | production | test
DEBUG=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173   # comma-separated, explicit origins only

# Supabase: Project Settings -> API (URL, anon key, service_role key) and -> JWT Keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=             # used server-side only, for Supabase Auth sign-in/sign-up
SUPABASE_SERVICE_ROLE_KEY=     # bypasses RLS: backend only
# Legacy HS256 JWT secret. Needed only if your project still signs user tokens with it;
# projects on asymmetric signing keys are verified via JWKS and can leave this empty.
SUPABASE_JWT_SECRET=
# Postgres connection string, only for applying supabase/schema.sql with psql.
DATABASE_URL=

# Gemini (optional). Without a key the analyst uses the deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Scanning limits
# Multiplies every rate limit (signup, sign-in, DNS check, uploads...). Local testing only; keep 1 in production.
RATE_LIMIT_SCALE=1
# Admin portal. Two-factor for admin routes defaults to on when APP_ENV=production; never turn it off there.
ADMIN_REQUIRE_MFA=
# Reverse proxies in front of the API whose X-Forwarded-For you trust (0 = ignore the header).
TRUSTED_PROXY_COUNT=0
SCAN_RATE_LIMIT_PER_MIN=5      # scans per user per minute (per API instance)
SCAN_MAX_CONCURRENT_HOSTS=3
SCAN_HTTP_TIMEOUT_SECONDS=5
SCAN_MAX_HOSTS=50
# Run queued jobs inside the API process (dev). In production set false and run the worker.
RUN_JOBS_INLINE=true

# Trust the OS certificate store (behind TLS-intercepting antivirus or proxies).
USE_SYSTEM_CERTS=false
